<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!--
      Carpeta donde el addon busca el archivo CSV y donde escribe el log.
      Si la dejas vacia, usa la carpeta del propio .exe.
    -->
    <add key="CarpetaDatos" value="" />
    <add key="ArchivoCsv" value="PuntosEmision.csv" />
  </appSettings>
</configuration>
