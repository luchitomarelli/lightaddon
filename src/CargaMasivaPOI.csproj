<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-47A8-9B0C-1234567890AB}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CargaMasivaPOI</RootNamespace>
    <AssemblyName>CargaMasivaPOI</AssemblyName>
    <!-- El SDK de SAP B1 es COM. .NET Framework 4.8 es la eleccion segura (NO .NET Core). -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- ===== Debug | x86 ===== -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- ===== Release | x86 ===== -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ============================================================================
      REFERENCIAS AL SDK DE SAP BUSINESS ONE
      ============================================================================
      Estas dos DLLs las instala el "SAP Business One SDK / DI API".
      En Visual Studio: clic derecho en el proyecto > Agregar referencia >
      pestania "COM" y tilda "SAP Business One UI API" y "SAP Business One DI API".
      VS generara los ensamblados Interop automaticamente.

      Si preferis referenciarlos por archivo, ajusta estos HintPath a la ruta
      de tu instalacion (la ruta tipica es la de abajo):
    -->
    <Reference Include="Interop.SAPbouiCOM">
      <HintPath>C:\Program Files (x86)\SAP\SAP Business One DI API\Interop.SAPbouiCOM.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.SAPbobsCOM">
      <HintPath>C:\Program Files (x86)\SAP\SAP Business One DI API\Interop.SAPbobsCOM.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>

    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Addon.cs" />
    <Compile Include="SboConnection.cs" />
    <Compile Include="MatrizLoader.cs" />
    <Compile Include="SerieNumeracion.cs" />
    <Compile Include="CsvReader.cs" />
    <Compile Include="Logger.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
