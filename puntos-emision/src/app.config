<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!-- Carpeta y nombre del CSV de Puntos de Emision. -->
    <add key="CarpetaDatos" value="C:\Seidor\POI" />
    <add key="ArchivoCsv" value="PuntosEmisionDef.csv" />
  </appSettings>
</configuration>
